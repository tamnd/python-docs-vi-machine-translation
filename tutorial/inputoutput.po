# pydocvi: model=gpt-5-6 prompt=574466d7 glossary=1 batch=d773b2b4d733 run=2026-08-17T16:43Z
#, fuzzy
msgid ""
"To change the file object's position, use ``f.seek(offset, whence)``.  The "
"position is computed from adding *offset* to a reference point; the reference"
" point is selected by the *whence* argument.  A *whence* value of 0 measures "
"from the beginning of the file, 1 uses the current file position, and 2 uses "
"the end of the file as the reference point.  *whence* can be omitted and "
"defaults to 0, using the beginning of the file as the reference point. ::"
msgstr ""
"Thay đổi vị trí tệp của đối tượng tệp, sử dụng ``f.seek(offset, whence)``. Vị"
" trí được tính bằng cách cộng *offset* vào một điểm tham chiếu; điểm tham "
"chiếu được chọn bởi đối số *whence*. Giá trị *whence* là 0 sẽ đo từ đầu tệp, "
"1 sử dụng vị trí tệp hiện tại, và 2 sử dụng cuối tệp làm điểm tham chiếu. Có "
"thể bỏ qua *whence* và mặc định là 0, sử dụng đầu tệp làm điểm tham chiếu. ::"

